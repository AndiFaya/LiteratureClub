@{
    ViewData["Title"] = "Confirm Payment";
    var paymentData = ViewBag.PaymentData as Dictionary<string, string>;
    var transaction = ViewBag.Transaction as BookSwap.Models.Transaction;
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title mb-1">Order Summary</h5>
                <hr />
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Book</span>
                    <span class="fw-semibold">@transaction?.Listing?.Title</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Seller</span>
                    <span>@transaction?.Seller?.DisplayUsername</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Amount</span>
                    <span class="fw-bold text-success fs-5">
                        R @transaction?.Amount.ToString("N2")
                    </span>
                </div>
                <hr />
                <p class="text-muted small mb-0">
                    You will be redirected to PayFast's secure payment page to complete your payment.
                    You will receive a verification code by email once payment is confirmed.
                </p>
            </div>
        </div>

        <div class="card shadow-sm border-0 bg-light mb-3 p-3 d-flex flex-row align-items-center gap-3">
            <span style="font-size:28px">🔒</span>
            <div>
                <div class="fw-semibold small">Secure payment via PayFast</div>
                <div class="text-muted" style="font-size:12px">
                    Your payment details are handled by PayFast and are never stored by BookSwap.
                </div>
            </div>
        </div>

        @* Auto-submit form to PayFast sandbox *@
        <form id="payfast-form" action="@ViewBag.PayFastUrl" method="POST">
            @foreach (var field in paymentData ?? new Dictionary<string, string>())
            {
                <input type="hidden" name="@field.Key" value="@field.Value" />
            }
            <button type="submit" id="pay-btn" class="btn btn-success w-100 py-2 fw-semibold">
                Proceed to Payment — R @transaction?.Amount.ToString("N2")
            </button>
        </form>

        <div class="text-center mt-3">
            <a asp-controller="Listings" asp-action="Detail"
               asp-route-id="@transaction?.ListingId"
               class="text-muted small">Cancel and go back</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Disable the button after click to prevent double-submission
        document.getElementById('pay-btn').addEventListener('click', function () {
            this.disabled = true;
            this.textContent = 'Redirecting to PayFast…';
        });
    </script>
}
