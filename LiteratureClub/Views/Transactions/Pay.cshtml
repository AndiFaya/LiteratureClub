@{
    ViewData["Title"] = "Confirm Payment";
    var paymentData = ViewBag.PaymentData as Dictionary<string, string>;
    var transaction = ViewBag.Transaction as LiteratureClub.Models.Transaction;
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title mb-1">Order Summary</h5>
                <hr />
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Book</span>
                    <span class="fw-semibold">@transaction?.Listing?.Title</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Seller</span>
                    <span>@transaction?.Seller?.DisplayUsername</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Amount</span>
                    <span class="fw-bold text-success fs-5">
                        R @transaction?.Amount.ToString("N2")
                    </span>
                </div>
                <hr />
                <p class="text-muted small mb-0">
                    Click <strong>Proceed to Payment</strong> below to complete your
                    purchase securely via PayFast. You will receive a verification
                    code by email once payment is confirmed.
                </p>
            </div>
        </div>

        <div class="card shadow-sm border-0 bg-light mb-4 p-3 d-flex flex-row align-items-center gap-3">
            <span style="font-size:28px">🔒</span>
            <div>
                <div class="fw-semibold small">Secure payment via PayFast</div>
                <div class="text-muted" style="font-size:12px">
                    Your payment details are handled by PayFast and are never stored by LiteratureClub.
                </div>
            </div>
        </div>

        @* Hidden PayFast form — submitted by the button below *@
        <form id="payfast-form"
              action="@ViewBag.PayFastUrl"
              method="POST">
            @foreach (var field in paymentData ?? new Dictionary<string, string>())
            {
                <input type="hidden" name="@field.Key" value="@field.Value" />
            }
        </form>

        @* Visible button — submits the hidden form above *@
        <button type="button"
                id="pay-btn"
                class="btn btn-success w-100 py-2 fw-semibold"
                onclick="submitPayment()">
            Proceed to Payment — R @transaction?.Amount.ToString("N2")
        </button>

        <div class="text-center mt-3">
            <a asp-controller="Listings"
                   asp-action="Detail"
                   asp-route-id="@transaction?.ListingId"
                   class="text-muted small">
                Cancel and go back
            </a>
        </div>

        @* Debug panel — shows in development so you can verify fields *@
        @if (System.Diagnostics.Debugger.IsAttached)
        {
            <div class="card mt-4 border-warning">
                <div class="card-header bg-warning text-dark small fw-bold">
                    Dev — PayFast fields being submitted
                </div>
                <div class="card-body p-2">
                    <table class="table table-sm mb-0" style="font-size:11px">
                        @foreach (var field in paymentData ?? new Dictionary<string, string>())
                        {
                            <tr>
                                <td class="text-muted">@field.Key</td>
                                <td class="fw-semibold" style="word-break:break-all">@field.Value</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script>
        function submitPayment() {
            var btn = document.getElementById('pay-btn');
            btn.disabled = true;
            btn.textContent = 'Redirecting to PayFast…';

            // Small delay so the UI update is visible, then submit
            setTimeout(function () {
                document.getElementById('payfast-form').submit();
            }, 300);
        }
    </script>
}