@{
    ViewData["Title"] = "Confirm Payment";
    var paymentData = ViewBag.PaymentData as Dictionary<string, string>;
    var transaction = ViewBag.Transaction as LiteratureClub.Models.Transaction;
    var signatureInput = ViewBag.SignatureInput as string;
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title mb-1">Order Summary</h5>
                <hr />
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Book</span>
                    <span class="fw-semibold">@transaction?.Listing?.Title</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Seller</span>
                    <span>@transaction?.Seller?.DisplayUsername</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Amount</span>
                    <span class="fw-bold text-success fs-5">
                        R @transaction?.Amount.ToString("N2")
                    </span>
                </div>
                <hr />
                <p class="text-muted small mb-0">
                    Click <strong>Proceed to Payment</strong> to pay securely via PayFast.
                    You will receive a 6-digit verification code by email once confirmed.
                </p>
            </div>
        </div>

        <div class="card border-0 bg-light mb-4 p-3 d-flex flex-row align-items-center gap-3">
            <span style="font-size:28px">🔒</span>
            <div>
                <div class="fw-semibold small">Secure payment via PayFast</div>
                <div class="text-muted" style="font-size:12px">
                    Your card details are handled by PayFast and never stored here.
                </div>
            </div>
        </div>

        @* Hidden form — submitted by the button below *@
        <form id="payfast-form" action="@ViewBag.PayFastUrl" method="POST">
            @foreach (var field in paymentData ?? new Dictionary<string, string>())
            {
                <input type="hidden" name="@field.Key" value="@field.Value" />
            }
        </form>

        <button type="button" id="pay-btn"
                class="btn btn-success w-100 py-2 fw-semibold"
                onclick="submitPayment()">
            Proceed to Payment — R @transaction?.Amount.ToString("N2")
        </button>

        <div class="text-center mt-3">
            <a asp-controller="Listings" asp-action="Detail"
               asp-route-id="@transaction?.ListingId"
               class="text-muted small">Cancel and go back</a>
        </div>

        @* Diagnostic panel — remove before going live *@
        <div class="card mt-4 border-warning">
            <div class="card-header bg-warning text-dark small fw-bold d-flex justify-content-between">
                <span>🔧 PayFast Diagnostic</span>
                <button class="btn btn-sm btn-outline-dark py-0"
                        onclick="document.getElementById('diag').classList.toggle('d-none')">
                    Toggle
                </button>
            </div>
            <div id="diag" class="card-body p-2">
                <p class="text-muted small mb-2">
                    Paste the <strong>Signature input string</strong> into
                    <a href="https://www.md5hashgenerator.com" target="_blank">md5hashgenerator.com</a>.
                    The result must equal the <strong>signature</strong> field value below.
                    If it doesn't, your passphrase in <code>appsettings.json</code>
                    doesn't match your PayFast sandbox account setting.
                </p>
                <table class="table table-sm mb-2" style="font-size:11px">
                    <thead class="table-light">
                        <tr><th>Field</th><th>Value</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var field in paymentData ?? new Dictionary<string, string>())
                        {
                            <tr class="@(field.Key == "signature" ? "table-warning" : "")">
                                <td class="text-muted">@field.Key</td>
                                <td style="word-break:break-all;font-family:monospace">
                                    @field.Value
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="mb-0">
                    <div class="text-muted small fw-bold mb-1">
                        Signature input string (MD5 this to get the signature above):
                    </div>
                    <div class="bg-light border rounded p-2"
                         style="word-break:break-all;font-size:10px;font-family:monospace">
                        @signatureInput
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function submitPayment() {
            var btn = document.getElementById('pay-btn');
            btn.disabled = true;
            btn.textContent = 'Redirecting to PayFast…';
            setTimeout(function () {
                document.getElementById('payfast-form').submit();
            }, 400);
        }
    </script>
}