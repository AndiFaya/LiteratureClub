@model LiteratureClub.Models.Receipt
@{
    ViewData["Title"] = "Receipt";
    Layout = "_Layout";
}

<style>
    @@media print {
        .no-print { display: none !important; }
        .card { border: 1px solid #dee2e6 !important; }
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="d-flex justify-content-between align-items-center mb-3 no-print">
            <a asp-controller="Dashboard" asp-action="Index"
               class="btn btn-outline-secondary btn-sm">
                ← Back to Dashboard
            </a>
            <button onclick="window.print()" class="btn btn-outline-primary btn-sm">
                🖨 Print Receipt
            </button>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <!-- Header -->
                <div class="text-center mb-4">
                    <div style="font-size:36px">📚</div>
                    <h4 class="mb-0 fw-bold">LiteratureClub</h4>
                    <p class="text-muted small">Student Textbook Marketplace</p>
                    <span class="badge bg-success px-3 py-2">Transaction Receipt</span>
                </div>

                <hr />

                <!-- Transaction info -->
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <div class="text-muted small">Receipt #</div>
                        <div class="fw-semibold">RCP-@Model.Id.ToString("D6")</div>
                    </div>
                    <div class="col-6 text-end">
                        <div class="text-muted small">Date Issued</div>
                        <div class="fw-semibold">@Model.IssuedAt.ToString("dd MMM yyyy")</div>
                    </div>
                </div>

                <!-- Book details -->
                <div class="bg-light rounded p-3 mb-4">
                    <div class="text-muted small mb-1">Textbook</div>
                    <div class="fw-semibold">@Model.TextbookTitle</div>
                    <div class="text-muted small">@Model.TextbookAuthor</div>
                    @if (!string.IsNullOrEmpty(Model.ISBN))
                    {
                        <div class="text-muted small">ISBN: @Model.ISBN</div>
                    }
                </div>

                <!-- Parties -->
                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="text-muted small mb-1">Sold by</div>
                        <div class="fw-semibold">@Model.SellerName</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small mb-1">Purchased by</div>
                        <div class="fw-semibold">@Model.BuyerName</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.PickupPointName))
                {
                    <div class="mb-4">
                        <div class="text-muted small mb-1">Exchange location</div>
                        <div class="fw-semibold">@Model.PickupPointName</div>
                    </div>
                }

                <hr />

                <!-- Amount -->
                <div class="d-flex justify-content-between align-items-center py-2">
                    <span class="text-muted">Subtotal</span>
                    <span>R @Model.AmountPaid.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2">
                    <span class="text-muted">Platform fee</span>
                    <span class="text-success">Free</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-top mt-2">
                    <span class="fw-bold fs-5">Total Paid</span>
                    <span class="fw-bold fs-5 text-success">R @Model.AmountPaid.ToString("N2")</span>
                </div>

                <hr class="mt-3" />

                <p class="text-muted text-center mb-0" style="font-size:11px">
                    This receipt was generated by LiteratureClub and confirms the successful exchange
                    of the above textbook between the parties listed. Transaction ID:
                    TXN-@Model.TransactionId.ToString("D6")
                </p>

            </div>
        </div>

    </div>
</div>
