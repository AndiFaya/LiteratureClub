@model LiteratureClub.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5 col-lg-4">

        <h2 class="mb-1">Welcome Back</h2>
        <p class="text-muted mb-4">Sign in to your LiteratureClub account.</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!ViewData.ModelState.IsValid &&
             ViewData.ModelState.ContainsKey(string.Empty) &&
             ViewData.ModelState[string.Empty]!.Errors.Any())
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
                @if (ViewData["UnverifiedEmail"] != null)
                {
                    <hr class="my-2" />
                    <div class="d-flex align-items-center gap-2">
                        <span class="small">Didn't get the email?</span>
                        <a asp-action="ResendVerification"
                               class="btn btn-sm btn-outline-warning">
                            Resend verification link
                        </a>
                    </div>
                }
            </div>
        }

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    University Email <span class="text-danger">*</span>
                </label>
                <input asp-for="Email" type="email" class="form-control"
                       placeholder="you@university.ac.za"
                       autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">
                    Password <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <input asp-for="Password" type="password" id="loginPassword"
                           class="form-control" placeholder="Your password"
                           autocomplete="current-password" />
                    <button type="button" class="btn btn-outline-secondary"
                            id="toggleLoginPassword" tabindex="-1">
                        Show
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Keep me signed in</label>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Sign In</button>
        </form>

        <hr class="my-4" />
        <div class="text-center">
            <p class="text-muted mb-1">
                Don't have an account?
                <a asp-action="Register">Create one here</a>
            </p>
            <p class="text-muted mb-0 small">
                Waiting for your verification email?
                <a asp-action="ResendVerification">Resend it</a>
            </p>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('toggleLoginPassword').addEventListener('click', function () {
            const input = document.getElementById('loginPassword');
            const isText = input.type === 'text';
            input.type = isText ? 'password' : 'text';
            this.textContent = isText ? 'Show' : 'Hide';
        });
    </script>
}
