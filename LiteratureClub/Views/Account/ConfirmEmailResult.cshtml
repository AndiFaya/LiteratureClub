@{
    ViewData["Title"] = "Email Verification";
}

<div class="row justify-content-center mt-5">
<div class="col-md-5 text-center">

    @if (!string.IsNullOrEmpty(ViewBag.Error as string))
    {
        <h2 class="mb-2">Verification Failed</h2>
        <p class="text-muted mb-4">@ViewBag.Error</p>
        <a asp-action="Register" asp-controller="Account" class="btn btn-primary">
            Register Again
        </a>
    }
    else
    {
        <div style="font-size:56px" class="mb-3">✅</div>
        <h2 class="mb-2">Email Verified!</h2>
        <p class="text-muted mb-4">
            Your email has been verified. You can now sign in to your LiteratureClub account.
        </p>
        <a asp-action="Login" asp-controller="Account" class="btn btn-primary">
            Sign In
        </a>
    }

</div>
</div>
