@{
    ViewData["Title"] = "Password Updated";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5 text-center">
            <div class="card shadow border-0 p-5 rounded-3">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success display-1"></i>
                </div>
                <h2 class="fw-bold mb-3 translate-me">Password Reset Complete</h2>
                <p class="text-muted mb-4 translate-me">
                    Your password has been successfully updated. You can now use your new credentials to access your textbook listings and account data.
                </p>
                <div class="d-grid">
                    <a asp-action="Login" class="btn btn-primary py-2 fw-semibold translate-me">Sign In to SomaShare</a>
                </div>
            </div>
        </div>
    </div>
</div>