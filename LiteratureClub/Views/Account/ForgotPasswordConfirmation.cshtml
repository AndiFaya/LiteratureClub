@{
    ViewData["Title"] = "Link Dispatched";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow border-0 p-5 rounded-3">
                <div class="mb-4">
                    <i class="bi bi-envelope-check text-success display-1"></i>
                </div>
                <h2 class="fw-bold mb-3 translate-me">Check Your Inbox</h2>
                <p class="text-muted fs-5 mb-4 translate-me">
                    If an account matches that email address, we have sent a secure message containing instructions to reset your marketplace credentials.
                </p>
                <p class="text-muted small mb-4 translate-me">
                    Be sure to check your spam or junk folder if you don't see the email within a few minutes.
                </p>
                <div>
                    <a asp-action="Login" class="btn btn-outline-secondary px-4 translate-me">Return to Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>