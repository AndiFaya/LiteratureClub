@model IEnumerable<LiteratureClub.Models.Report>
@{
    ViewData["Title"] = "User Infraction Reports";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>⚠️ Member Reports Center</h2>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Console</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Reporter</th>
                        <th>Target Item / User</th>
                        <th>Reason Given</th>
                        <th>Date Flagged</th>
                        <th>Status</th>
                        <th class="text-end">Resolution</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Clean slate! No pending player or listing reports.</td>
                        </tr>
                    }
                    @foreach (var report in Model)
                    {
                        <tr>
                            <td>@report.ReportedUser?.DisplayUsername</td>
                            <td><span class="text-wrap">@report.TargetType</span></td>
                            <td class="text-muted small">@report.Reason</td>
                            <td>@report.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (report.Status == ReportStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (report.Status == ReportStatus.Resolved)
                                {
                                    <span class="badge bg-success">Resolved</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Dismissed</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (report.Status == ReportStatus.Pending)
                                {
                                    <div class="d-inline-flex gap-2">
                                        <form asp-action="ResolveReport" method="post" class="m-0">
                                            <input type="hidden" name="reportId" value="@report.Id" />
                                            <button type="submit" class="btn btn-success btn-sm">Resolve</button>
                                        </form>
                                        <form asp-action="DismissReport" method="post" class="m-0">
                                            <input type="hidden" name="reportId" value="@report.Id" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm">Dismiss</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small italic">Actioned</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>