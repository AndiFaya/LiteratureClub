
@{
    ViewData["Title"] = "Chat";
}

@Html.AntiForgeryToken()

<div class="chat-container">
    <div class="chat-messages" id="chatMessages">
        <div class="chat-welcome" id="chatWelcome">
            <h2>How can I help you today?</h2>
            <p>Type your question below.</p>
        </div>
    </div>

    @if (!User.Identity.IsAuthenticated)
    {
        <div class="alert alert-info text-center m-2 shadow-sm border-0">
            <h6 class="mb-1">💡 Want to check your orders or listings?</h6>
            <small class="text-muted">Please <a href="/Account/Login" class="fw-bold text-decoration-underline">Login</a> to unlock personalized account assistance.</small>
        </div>
    }

    <div class="chat-input-area d-flex align-items-center p-2 bg-light border-top">
        <input type="text" id="chatInput" placeholder="Type your message..." maxlength="4000" class="form-control me-2" />
        <button type="button" id="btnSend" class="btn btn-warning fw-bold">Send</button>
    </div>
</div>

@section Scripts
{
    <script>
        document.getElementById('btnSend').onclick = sendMessage;
        document.getElementById('chatInput').onkeydown = function(e) {
            if (e.key === 'Enter') { e.preventDefault(); sendMessage(); }
        };

        // Listen for toggle changes to update the placeholder text nicely
        document.getElementById('languageToggle').onchange = function() {
            var mode = this.value;
            var input = document.getElementById('chatInput');
            if (mode === 'chat') {
                input.placeholder = "Type your message...";
            } else {
                input.placeholder = "Type text to translate into " + mode + "...";
            }
        };

        function addMessage(role, text, isError) {
            document.getElementById('chatWelcome').style.display = 'none';
            var div = document.createElement('div');
            div.className = 'chat-message ' + (role === 'user' ? 'user' : 'ai-agent') + (isError ? ' chat-error' : '');
            div.innerHTML = '<span class="chat-avatar">' + (role === 'user' ? 'U' : 'AI') + '</span><span class="chat-text">' + text + '</span>';
            document.getElementById('chatMessages').appendChild(div);
            div.scrollIntoView({ behavior: 'smooth' });
        }

        async function sendMessage() {
            var input = document.getElementById('chatInput');
            var text = input.value.trim();
            var mode = document.getElementById('languageToggle').value;

            if (!text) return;

            // Build history BEFORE adding the new message
            var history = [];
            var msgs = document.querySelectorAll('.chat-message');
            for (var i = 0; i < msgs.length; i++) {
                var el = msgs[i];
                var txt = el.querySelector('.chat-text').textContent;
                var assignedRole = el.classList.contains('user') ? 'user' : 'ai agent';
                history.push({ role: assignedRole, content: txt });
            }

            // Clear input and display what user wrote
            input.value = '';
            addMessage('user', text);

            document.getElementById('btnSend').disabled = true;

            // If a language translation is active, tweak the prompt dynamically before sending it to C#
            var finalPayloadMessage = text;
            if (mode !== 'chat') {
                finalPayloadMessage = "[TRANSLATE_MODE=" + mode + "] " + text;
            }

            try {
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var res = await fetch('/Chat/SendMessage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ message: finalPayloadMessage, history: history })
                });

                var data = await res.json();

                if (data.success) {
                    addMessage('ai agent', data.message, false);
                } else {
                    addMessage('ai agent', data.error || 'An unexpected server error occurred.', true);
                }
            }
            catch (e) {
                addMessage('ai agent', 'Connection Failed. Please verify your server connection.', true);
            }
            finally {
                document.getElementById('btnSend').disabled = false;
                document.getElementById('chatInput').focus();
            }
        }
    </script>
}