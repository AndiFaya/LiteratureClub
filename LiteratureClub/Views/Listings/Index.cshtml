@model LiteratureClub.ViewModels.ListingIndexViewModel
@{
    ViewData["Title"] = "Browse Books";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Browse Books</h2>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Sell a Book</a>
    }
</div>

<form method="get" asp-action="Index">
    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <input type="text" name="searchTerm" value="@Model.SearchTerm"
                   class="form-control" placeholder="Search title, author or ISBN…" />
        </div>
        <div class="col-md-2">
            <select name="categoryId" class="form-select">
                <option value="">All categories</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Label</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="courseCodeId" class="form-select">
                <option value="">All courses</option>
                @foreach (var c in Model.CourseCodes)
                {
                    <option value="@c.Id" selected="@(Model.CourseCodeId == c.Id)">@c.Label</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="condition" class="form-select">
                <option value="">All conditions</option>
                <option value="0" selected="@(Model.Condition == LiteratureClub.Models.BookCondition.New)">New</option>
                <option value="1" selected="@(Model.Condition == LiteratureClub.Models.BookCondition.Used)">Used</option>
            </select>
        </div>
        <div class="col-md-1">
            <input type="number" name="maxPrice" value="@Model.MaxPrice"
                   class="form-control" placeholder="Max R" min="0" />
        </div>
        <div class="col-md-1">
            <select name="sortBy" class="form-select">
                <option value="newest" selected="@(Model.SortBy == "newest")">Newest</option>
                <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price ↑</option>
                <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price ↓</option>
                <option value="oldest" selected="@(Model.SortBy == "oldest")">Oldest</option>
            </select>
        </div>
    </div>
    <div class="d-flex gap-2 mb-3">
        <button type="submit" class="btn btn-primary btn-sm">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
    </div>
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p class="text-muted small mb-3">@Model.Listings.Count listing(s) found</p>

@if (!Model.Listings.Any())
{
    <div class="text-center py-5 text-muted">
        <p class="fs-5">No listings match your search.</p>
        <p>Try adjusting your filters or <a asp-action="Create">post one yourself</a>.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        @foreach (var listing in Model.Listings)
        {
            <div class="col">
                <a asp-action="Detail" asp-route-id="@listing.Id"
                   class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(listing.ImagePath))
                        {
                            <img src="@listing.ImagePath" class="card-img-top"
                                 style="height:140px;object-fit:cover;" alt="@listing.Title" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center
                                        justify-content-center" style="height:140px;font-size:40px;">
                                📚
                            </div>
                        }
                        <div class="card-body p-3">
                            <div class="d-flex gap-1 mb-2 flex-wrap">
                                <span class="badge @(listing.Condition == LiteratureClub.Models.BookCondition.New ? "bg-success" : "bg-warning text-dark")">
                                    @listing.Condition
                                </span>
                                @if (listing.IsOpenForBidding)
                                {
                                    <span class="badge bg-info text-dark">Bids open</span>
                                }
                            </div>
                            <h6 class="card-title mb-1" style="font-size:14px;line-height:1.3">
                                @listing.Title
                            </h6>
                            <p class="text-muted mb-1" style="font-size:12px">
                                @listing.Author
                                @if (!string.IsNullOrEmpty(listing.Edition))
                                {
                                    <span>· @listing.Edition ed</span>
                                }
                            </p>
                            <p class="fw-semibold mb-1" style="font-size:16px">R @listing.Price.ToString("N2")</p>
                            <p class="text-muted mb-0" style="font-size:11px">
                                @listing.CourseCode · @listing.SellerUsername
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}
