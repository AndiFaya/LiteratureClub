@model LiteratureClub.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!--Profile header-->
<div class="card mb-4 shadow-sm">
    <div class="card-body d-flex flex-wrap align-items-center gap-4">
        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold"
             style="width:56px;height:56px;font-size:22px;flex-shrink:0">
            @Model.DisplayUsername.Substring(0, 1).ToUpper()
        </div>
        <div class="flex-grow-1">
            <h5 class="mb-0">@Model.DisplayUsername</h5>
            <div class="text-muted small">@Model.FullName · @Model.Campus</div>
            @if (Model.TotalReviews > 0)
            {
                <div class="small">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span style="color:@(i <= Math.Round(Model.AverageRating) ? "#d97706" : "#ccc")">★</span>
                    }
                    <span class="text-muted">@Model.AverageRating.ToString("N1") (@Model.TotalReviews reviews)</span>
                </div>
            }
        </div>
        <div class="text-end">
            <div class="text-muted small">Earnings Balance</div>
            <div class="fs-5 fw-semibold text-success">R @Model.EarningsBalance.ToString("N2")</div>
        </div>
    </div>
</div>

<!--Stat cards-->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-2">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold text-primary">@Model.ActiveListingsCount</div>
                <div class="text-muted small">Active Listings</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold text-success">@Model.TotalSalesCount</div>
                <div class="text-muted small">Total Sales</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold text-info">@Model.TotalPurchasesCount</div>
                <div class="text-muted small">Purchases</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold text-warning">@Model.PendingBidsCount</div>
                <div class="text-muted small">Pending Bids</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold">@Model.WatchlistCount</div>
                <div class="text-muted small">Watchlist</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold text-danger">@Model.UnreadMessagesCount</div>
                <div class="text-muted small">Unread Messages</div>
            </div>
        </div>
    </div>
</div>



<!--Tabbed sections-->
<ul class="nav nav-tabs mb-3" id="dashboardTabs">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#myListings">
            My Listings
            @if (Model.ActiveListingsCount > 0)
            {
                <span class="badge bg-primary ms-1">@Model.ActiveListingsCount</span>
            }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#incomingBids">
            Incoming Bids
            @if (Model.PendingBidsCount > 0)
            {
                <span class="badge bg-warning text-dark ms-1">@Model.PendingBidsCount</span>
            }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#myPurchases">Purchases</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#mySales">Sales</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#watchlist">
            Watchlist
            @if (Model.WatchlistCount > 0)
            {
                <span class="badge bg-secondary ms-1">@Model.WatchlistCount</span>
            }
        </a>
    </li>
</ul>

<div class="tab-content">

    <!--My Listings-->
    <div class="tab-pane fade show active" id="myListings">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0">Your listings</h6>
            <a asp-controller="Listings" asp-action="Create" class="btn btn-primary btn-sm">
                + New Listing
            </a>
        </div>
        @if (!Model.MyListings.Any())
        {
            <div class="text-center py-4 text-muted">
                <p>You haven't posted any listings yet.</p>
                <a asp-controller="Listings" asp-action="Create" class="btn btn-primary btn-sm">
                    Post your first listing
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Book</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Bids</th>
                            <th>Listed</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.MyListings)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Listings" asp-action="Detail"
                                       asp-route-id="@l.Id" class="text-decoration-none fw-semibold">
                                        @l.Title
                                    </a>
                                </td>
                                <td>R @l.Price.ToString("N2")</td>
                                <td>
                                    <span class="badge @(l.Status == LiteratureClub.Models.ListingStatus.Available ? "bg-success" : l.Status == LiteratureClub.Models.ListingStatus.Sold ? "bg-secondary" : "bg-warning text-dark")">
                                        @l.Status
                                    </span>
                                </td>
                                <td>
                                    @if (l.BidCount > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@l.BidCount pending</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-muted small">@l.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (l.Status == LiteratureClub.Models.ListingStatus.Available)
                                    {
                                        <a asp-controller="Listings" asp-action="Edit"
                                           asp-route-id="@l.Id"
                                           class="btn btn-outline-secondary btn-sm">
                                            Edit
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @l.Status
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!--Incoming Bids-->
    <div class="tab-pane fade" id="incomingBids">
        <h6 class="mb-3">Pending bids on your listings</h6>
        @if (!Model.IncomingBids.Any())
        {
            <p class="text-muted text-center py-4">No pending bids.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Listing</th>
                            <th>From</th>
                            <th>Offer</th>
                            <th>Qty</th>
                            <th>Expires</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.IncomingBids)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Listings" asp-action="Detail"
                                       asp-route-id="@b.ListingId" class="text-decoration-none">
                                        @b.ListingTitle
                                    </a>
                                </td>
                                <td>@b.BidderUsername</td>
                                <td class="fw-semibold">R @b.OfferAmount.ToString("N2")</td>
                                <td>@b.Quantity</td>
                                <td class="text-muted small">@b.ExpiresAt.ToString("dd MMM")</td>
                                <td class="d-flex gap-1">
                                    <form asp-controller="Bids" asp-action="Accept" method="post">
                                        <input type="hidden" name="bidId" value="@b.BidId" />
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-success btn-sm">Accept</button>
                                    </form>
                                    <form asp-controller="Bids" asp-action="Reject" method="post">
                                        <input type="hidden" name="bidId" value="@b.BidId" />
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-outline-secondary btn-sm">Reject</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!--Purchases-->
    <div class="tab-pane fade" id="myPurchases">
        <h6 class="mb-3">Books you've bought</h6>
        @if (!Model.MyPurchases.Any())
        {
            <p class="text-muted text-center py-4">You haven't purchased any books yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Book</th>
                            <th>Seller</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.MyPurchases)
                        {
                            <tr>
                                <td class="fw-semibold">@t.BookTitle</td>
                                <td class="text-muted small">@t.OtherPartyUsername</td>
                                <td>R @t.Amount.ToString("N2")</td>
                                <td>
                                    <span class="badge @(t.Status == LiteratureClub.Models.TransactionStatus.Completed ? "bg-success" : t.Status == LiteratureClub.Models.TransactionStatus.Disputed ? "bg-danger" : "bg-warning text-dark")">
                                        @t.Status
                                    </span>
                                </td>
                                <td class="text-muted small">@t.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        @if (t.Status == LiteratureClub.Models.TransactionStatus.PaymentPending)
                                        {
                                            <a asp-controller="Transactions" asp-action="Pay"
                                               asp-route-id="@t.Id"
                                               class="btn btn-success btn-sm fw-semibold">
                                                💳 Pay Now
                                            </a>
                                        }
                                        <a asp-controller="Transactions" asp-action="Detail"
                                           asp-route-id="@t.Id"
                                           class="btn btn-primary btn-sm">
                                            View Transaction
                                        </a>
                                        @if (t.HasReceipt)
                                        {
                                            <a asp-controller="Transactions" asp-action="Receipt"
                                               asp-route-id="@t.Id"
                                               class="btn btn-outline-secondary btn-sm">
                                                Receipt
                                            </a>
                                        }
                                        @if (t.Status == LiteratureClub.Models.TransactionStatus.Completed && !t.HasReview)
                                        {
                                            <a asp-controller="Reviews" asp-action="Leave"
                                               asp-route-transactionId="@t.Id"
                                               class="btn btn-warning btn-sm fw-semibold">
                                                ★ Review Seller
                                            </a>
                                        }
                                        else if (t.HasReview)
                                        {
                                            <span class="btn btn-sm btn-outline-success disabled">
                                                ✓ Reviewed
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!--Sales-->
    <div class="tab-pane fade" id="mySales">
        <h6 class="mb-3">Books you've sold</h6>
        @if (!Model.MySales.Any())
        {
            <p class="text-muted text-center py-4">No completed sales yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Book</th>
                            <th>Buyer</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.MySales)
                        {
                            <tr>
                                <td class="fw-semibold">@t.BookTitle</td>
                                <td class="text-muted small">@t.OtherPartyUsername</td>
                                <td>R @t.Amount.ToString("N2")</td>
                                <td>
                                    <span class="badge @(t.Status == LiteratureClub.Models.TransactionStatus.Completed ? "bg-success" : t.Status == LiteratureClub.Models.TransactionStatus.Disputed ? "bg-danger" : "bg-warning text-dark")">
                                        @t.Status
                                    </span>
                                </td>
                                <td class="text-muted small">@t.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <a asp-controller="Transactions" asp-action="Detail"
                                           asp-route-id="@t.Id"
                                           class="btn btn-primary btn-sm">
                                            View Transaction
                                        </a>
                                        @if (t.HasReceipt)
                                        {
                                            <a asp-controller="Transactions" asp-action="Receipt"
                                               asp-route-id="@t.Id"
                                               class="btn btn-outline-secondary btn-sm">
                                                Receipt
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!--Watchlist-->
    <div class="tab-pane fade" id="watchlist">
        <h6 class="mb-3">Books you're watching</h6>
        @if (!Model.Watchlist.Any())
        {
            <p class="text-muted text-center py-4">
                Your watchlist is empty.
                <a asp-controller="Listings" asp-action="Index">Browse listings</a> to save books.
            </p>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
                @foreach (var listing in Model.Watchlist)
                {
                    <div class="col">
                        <a asp-controller="Listings" asp-action="Detail"
                           asp-route-id="@listing.Id" class="text-decoration-none text-dark">
                            <div class="card h-100 shadow-sm">
                                @if (!string.IsNullOrEmpty(listing.ImagePath))
                                {
                                    <img src="@listing.ImagePath" class="card-img-top"
                                         style="height:120px;object-fit:cover;" alt="@listing.Title" />
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center"
                                         style="height:120px;font-size:36px">
                                        📚
                                    </div>
                                }
                                <div class="card-body p-3">
                                    <div class="d-flex gap-1 mb-1">
                                        <span class="badge @(listing.Condition == LiteratureClub.Models.BookCondition.New ? "bg-success" : "bg-warning text-dark")" style="font-size:10px">
                                            @listing.Condition
                                        </span>
                                    </div>
                                    <p class="card-title mb-1 fw-semibold" style="font-size:13px">@listing.Title</p>
                                    <p class="text-muted mb-1" style="font-size:11px">@listing.Author</p>
                                    <p class="fw-semibold mb-0">R @listing.Price.ToString("N2")</p>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>

</div>